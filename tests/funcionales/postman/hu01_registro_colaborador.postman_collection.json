      "item": [
        {
          "name": "CP-01 · Registrar con honorario mensual (camino feliz)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"cedula\", \"10\" + String(Date.now()).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Código de negocio COLABORADOR_REGISTRADO\", () => pm.expect(pm.response.json().codigo).to.eql(\"COLABORADOR_REGISTRADO\"));",
                  "pm.collectionVariables.set(\"idLaura\", pm.response.json().id_colaborador);",
                  "pm.collectionVariables.set(\"cedulaLaura\", pm.collectionVariables.get(\"cedula\"));",
                  "pm.test(\"Mensaje para el usuario\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Colaborador registrado\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Rol",
                "value": "ADMINISTRATIVO"
              }
            ],
            "url": {
